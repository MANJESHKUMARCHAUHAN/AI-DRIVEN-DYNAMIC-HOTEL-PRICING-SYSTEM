# =============================================================================
# AI-Driven Dynamic Hotel Pricing System -- environment configuration
# =============================================================================
#
#   cp .env.example .env
#
# Every value below has a safe default in config/settings.py, so an empty .env
# still boots. Override only what you need.
#
# SECURITY
#   - .env is gitignored. .env.example (this file) is committed and must never
#     contain a real credential.
#   - Setting ENVIRONMENT=production makes the application refuse to start with
#     a default password or with DEBUG enabled.
#
# Validate your settings before starting containers:
#
#   python scripts/check_config.py
#
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=dynamic-hotel-pricing
APP_VERSION=0.1.0

# local | docker | production
ENVIRONMENT=local
DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console (human-readable) | json (log aggregators; used inside containers)
LOG_FORMAT=console
# Optional. Leave blank to log to stdout only.
LOG_FILE=


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Inside Docker Compose this must be the service name `postgres`, never
# localhost -- containers do not share a loopback interface.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hotel_pricing
POSTGRES_USER=pricing
POSTGRES_PASSWORD=change_me_locally

# Host port for the published Postgres container. Change if 5432 is already
# taken by a local PostgreSQL installation.
POSTGRES_HOST_PORT=5432

# Connection pool
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
POSTGRES_POOL_PRE_PING=true
# Echo every SQL statement. Very noisy; debugging only.
POSTGRES_ECHO=false


# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
# false lets the API run without a broker: event publishing degrades to a
# logged warning instead of failing the request.
KAFKA_ENABLED=true

# Inside Docker Compose: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=hotel-pricing
KAFKA_CONSUMER_GROUP=hotel-pricing-consumers

KAFKA_TOPIC_COMPETITOR=hotel.competitor_prices
KAFKA_TOPIC_BOOKINGS=hotel.booking_events
KAFKA_TOPIC_DEMAND=hotel.demand_events
KAFKA_TOPIC_PREDICTIONS=hotel.price_predictions

KAFKA_NUM_PARTITIONS=3
# 1 is correct for a single-broker development cluster.
KAFKA_REPLICATION_FACTOR=1

# earliest | latest | none
KAFKA_AUTO_OFFSET_RESET=earliest
# Keep false. Offsets are committed only after the database write succeeds,
# which is what makes the pipeline at-least-once instead of at-most-once.
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_RECORDS=500
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_REQUEST_TIMEOUT_MS=40000
KAFKA_RETRY_BACKOFF_MS=1000

# 0 | 1 | all   ("all" waits for every in-sync replica)
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=5
KAFKA_PRODUCER_LINGER_MS=50


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_PREFIX=/api/v1
API_TITLE=AI-Driven Dynamic Hotel Pricing API
# Set false to hide /docs, /redoc and /openapi.json in production.
API_DOCS_ENABLED=true
API_REQUEST_TIMEOUT_SECONDS=30

# Comma-separated. Never use "*".
API_CORS_ORIGINS=http://localhost:8501,http://dashboard:8501
API_CORS_ALLOW_CREDENTIALS=false

# Used by the dashboard container to reach the API by service name.
API_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# Models / MLOps
# -----------------------------------------------------------------------------
# Relative paths resolve against the project root.
MODEL_DIR=models/artifacts
MODEL_REGISTRY_FILE=registry.json
# Blank means "use whichever version is flagged active in the registry".
MODEL_ACTIVE_VERSION=

# blended_demand = w * prophet_forecast + (1 - w) * gradient_boosting_prediction
MODEL_PROPHET_BLEND_WEIGHT=0.5
PROPHET_FORECAST_HORIZONS=7,14,30


# -----------------------------------------------------------------------------
# Pricing
# -----------------------------------------------------------------------------
CURRENCY=INR
DEFAULT_BASE_PRICE=5000

# --- absolute guardrails: these always win ---
MIN_PRICE=2500
MAX_PRICE=25000

# --- relative guardrails: fractions, not percentages (0.15 == 15%) ---
MAX_DAILY_CHANGE_PERCENT=0.15
COMPETITOR_UPPER_BOUND_PERCENT=0.20
COMPETITOR_LOWER_BOUND_PERCENT=0.20

# Below this occupancy no price increase is permitted, whatever the model says.
LOW_OCCUPANCY_THRESHOLD=0.40

# --- per-signal clamps, applied before the four adjustments are summed ---
MAX_DEMAND_ADJUSTMENT=0.25
MAX_COMPETITOR_ADJUSTMENT=0.15
MAX_OCCUPANCY_ADJUSTMENT=0.20
MAX_EVENT_ADJUSTMENT=0.15

# Decimal places on the emitted price. 0 = whole rupees.
PRICE_ROUNDING=0


# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
# synthetic | booking | expedia
#
# ADR-004: the real scrapers require BOTH a non-synthetic source AND
# INGESTION_ENABLE_REAL_SCRAPERS=true. Setting only one is a configuration
# error and the application will refuse to start. Scraping Booking.com or
# Expedia may violate their terms of service -- that is your responsibility.
INGESTION_SOURCE=synthetic
INGESTION_ENABLE_REAL_SCRAPERS=false

INGESTION_REQUEST_TIMEOUT_SECONDS=15
INGESTION_RATE_LIMIT_SECONDS=2.0
INGESTION_MAX_RETRIES=3
INGESTION_USER_AGENT=dynamic-hotel-pricing/0.1 (research)

# Fixed seed -> reproducible synthetic datasets.
INGESTION_SYNTHETIC_SEED=42
INGESTION_SYNTHETIC_HOTELS=5
INGESTION_SYNTHETIC_HISTORY_DAYS=365
INGESTION_SYNTHETIC_INTERVAL_SECONDS=2.0


# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
MONITORING_ENABLED=true
# Population Stability Index above this is treated as feature drift.
MONITORING_DRIFT_PSI_THRESHOLD=0.2
MONITORING_PREDICTION_SIGMA_THRESHOLD=3.0
MONITORING_PERFORMANCE_DEGRADATION_PERCENT=0.20
MONITORING_METRICS_WINDOW_DAYS=30


# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
DATA_DIR=data
