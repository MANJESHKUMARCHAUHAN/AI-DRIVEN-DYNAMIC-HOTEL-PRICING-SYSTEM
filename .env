# Local development configuration -- generated during Phase 1 setup.
#
# THIS FILE IS GITIGNORED. The committed template is .env.example.
# The password below is a local development value only. Anything reachable from
# outside your machine needs a real secret and ENVIRONMENT=production.

ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# Host defaults. docker-compose.yml overrides these with service names.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hotel_pricing
POSTGRES_USER=pricing
POSTGRES_PASSWORD=local_dev_only_ch4nge_me
POSTGRES_HOST_PORT=5432

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8501,http://dashboard:8501

MODEL_DIR=models/artifacts

CURRENCY=INR
DEFAULT_BASE_PRICE=5000
MIN_PRICE=2500
MAX_PRICE=25000
MAX_DAILY_CHANGE_PERCENT=0.15

INGESTION_SOURCE=synthetic
INGESTION_ENABLE_REAL_SCRAPERS=false
INGESTION_SYNTHETIC_SEED=42

DATA_DIR=data
