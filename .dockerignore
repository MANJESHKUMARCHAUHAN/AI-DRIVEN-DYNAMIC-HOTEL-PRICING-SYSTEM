# Keep the build context small and, more importantly, keep secrets out of it.
# Anything sent to the daemon can end up in an image layer.

# --- secrets -----------------------------------------------------------------
# Configuration reaches containers through env_file/environment at run time,
# never baked into the image.
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# --- vcs ---------------------------------------------------------------------
.git
.gitignore
.github/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/

# --- testing -----------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/

# --- data and artifacts ------------------------------------------------------
# Mounted as volumes at run time; baking them in would bloat every layer.
data/
models/artifacts/
*.csv
*.parquet
*.joblib
*.pkl

# --- logs / editors / os -----------------------------------------------------
logs/
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- docs --------------------------------------------------------------------
docs/
*.md
!README.md
